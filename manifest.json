{
  "manifest_version": 3,
  "name": "New Tab Dashboard",
  "version": "1.0",
  "description": "Et personligt dashboard med ur, vejr, noter og kalender.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openweathermap.org/*"
  ]
}